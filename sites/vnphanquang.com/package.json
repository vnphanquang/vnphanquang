{
	"name": "vnphanquang.com",
	"version": "v3",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": [
			"./src/lib/*",
			"./src/lib/*.js",
			"./src/lib/*/index.js",
			"./src/lib/*.ts",
			"./src/lib/*/index.ts"
		],
		"#data/*": [
			"./src/data/*",
			"./src/data/*.js",
			"./src/data/*/index.js",
			"./src/data/*.ts",
			"./src/data/*/index.ts"
		]
	},
	"scripts": {
		"boot:env": "shx cp .env.example .env",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "run-p lint:*",
		"lint:es": "svelte-kit sync && eslint .",
		"lint:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint:style": "stylelint '**/*.{svelte,css}'",
		"format": "prettier --write --ignore-path=../../.prettierignore --config=../../prettier.config.js .",
		"docker:build": "docker buildx build ../.. --build-arg --target=vnphanquang.com --tag vnphanquang.com:latest",
		"docker:run": "docker run --rm --name=vnphanquang.com --publish 3000:3000 vnphanquang.com:latest"
	},
	"devDependencies": {
		"@svelte-put/avatar": "^4.0.0",
		"@atproto/api": "^0.20.44",
		"@svelte-put/copy": "^4.0.0",
		"@svelte-put/toc": "^6.0.2",
		"@sveltejs/adapter-node": "6.0.0-next.12",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "3.0.0-next.28",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@vnphanquang/gach": "workspace:*",
		"@vnphanquang/markdown": "workspace:*",
		"node-addon-api": "^8.9.2",
		"node-gyp": "^13.0.2",
		"schema-dts": "^2.0.0",
		"tailwindcss": "^4.3.3",
		"@types/estree": "^1.0.9",
		"github-slugger": "^2.0.0",
		"magic-string": "^1.4.1",
		"zimmerframe": "^1.1.5",
		"valibot": "^1.5.0"
	}
}

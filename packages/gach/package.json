{
	"name": "@vnphanquang/gach",
	"version": "0.0.0",
	"description": "gạch - building blocks for weaving webs",
	"private": true,
	"author": {
		"email": "oss@vnphanquang.com",
		"name": "quang",
		"url": "https://github.com/vnphanquang"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vnphanquang/vnphanquang.git"
	},
	"bugs": {
		"url": "https://github.com/vnphanquang/vnphanquang/issues"
	},
	"homepage": "https://github.com/vnphanquang/vnphanquang/tree/main/packages/gach",
	"keywords": [
		"css",
		"design system",
		"component",
		"tailwind"
	],
	"type": "module",
	"main": "src/index.js",
	"types": "types/index.d.ts",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./src/index.js"
		},
		"./constants": {
			"types": "./types/index.d.ts",
			"import": "./src/constants.js"
		},
		"./hooks": {
			"types": "./types/index.d.ts",
			"import": "./src/hooks.js"
		},
		"./vite": {
			"types": "./types/index.d.ts",
			"import": "./src/vite/index.js"
		},
		"./styles": "./src/styles/index.css",
		"./styles/custom-medias": "./src/styles/0-custom/medias.css",
		"./styles/custom-selectors": "./src/styles/0-custom/selectors.css"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"types",
		"README.md"
	],
	"scripts": {
		"lint": "run-p lint:*",
		"lint:es": "eslint .",
		"lint:style": "stylelint '**/*.{svelte,css}'",
		"format": "prettier --write --ignore-path=../../.prettierignore --config=../../prettier.config.js .",
		"build": "dts-buddy --write && publint"
	},
	"peerDependencies": {
		"@sveltejs/kit": ">=2.0.0",
		"svelte": ">=5.0.0"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": true
		},
		"@sveltejs/kit": {
			"optional": true
		}
	},
	"dependencies": {
		"@iconify-json/ph": "^1.2.2",
		"@iconify-json/simple-icons": "^1.2.96",
		"@iconify/tailwind4": "^1.2.3",
		"@tailwindcss/vite": "^4.3.3",
		"@vnphanquang/markdown": "workspace:*",
		"fontless": "^0.4.5",
		"postcss-color-scheme": "^2.1.0",
		"postcss-custom-media": "^12.0.1",
		"postcss-custom-selectors": "^9.0.1",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@sveltejs/kit": "3.0.0-next.27",
		"svelte": "^5.57.1"
	}

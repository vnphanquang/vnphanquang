{
	"name": "@vnphanquang/gach",
	"version": "1.1.1",
	"description": "gạch - building blocks for weaving webs - from vnphanquang",
	"author": {
		"email": "oss@vnphanquang.com",
		"name": "quang",
		"url": "https://github.com/vnphanquang"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vnphanquang/vnphanquang.git"
	},
	"bugs": {
		"url": "https://github.com/vnphanquang/vnphanquang/issues"
	},
	"homepage": "https://github.com/vnphanquang/vnphanquang/tree/main/packages/gach",
	"keywords": [
		"css",
		"design system",
		"component",
		"tailwind"
	],
	"type": "module",
	"main": "src/index.js",
	"svelte": "src/index.js",
	"types": "types/index.d.ts",
	"sideEffects": [
		"./styles",
		"./styles/custom-medias",
		"./styles/custom-selectors"
	],
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"default": "./src/index.js"
		},
		"./components": {
			"types": "./types/index.d.ts",
			"svelte": "./src/components/index.js",
			"default": "./src/components/index.js"
		},
		"./constants": {
			"types": "./types/index.d.ts",
			"default": "./src/constants.js"
		},
		"./contexts": {
			"types": "./types/index.d.ts",
			"svelte": "./src/contexts/index.js",
			"default": "./src/contexts/index.js"
		},
		"./hooks": {
			"types": "./types/index.d.ts",
			"default": "./src/hooks.js"
		},
		"./layouts": {
			"types": "./types/index.d.ts",
			"svelte": "./src/layouts/index.js",
			"default": "./src/layouts/index.js"
		},
		"./metadata": {
			"types": "./types/index.d.ts",
			"svelte": "./src/metadata/index.js",
			"default": "./src/metadata/index.js"
		},
		"./vite": {
			"types": "./types/index.d.ts",
			"default": "./src/vite/index.js"
		},
		"./styles": "./src/styles/index.css",
		"./styles/custom-medias": "./src/styles/0-custom/medias.css",
		"./styles/custom-selectors": "./src/styles/0-custom/selectors.css"
	},
	"typesVersions": {
		"*": {
			"components": [
				"./types/index.d.ts"
			],
			"constants": [
				"./types/index.d.ts"
			],
			"contexts": [
				"./types/index.d.ts"
			],
			"hooks": [
				"./types/index.d.ts"
			],
			"layouts": [
				"./types/index.d.ts"
			],
			"metadata": [
				"./types/index.d.ts"
			],
			"vite": [
				"./types/index.d.ts"
			]
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"types",
		"README.md"
	],
	"scripts": {
		"lint": "run-p lint:*",
		"lint:es": "eslint .",
		"lint:style": "stylelint '**/*.{svelte,css}'",
		"format": "prettier --write --ignore-path=../../.prettierignore --config=../../prettier.config.js .",
		"build": "dts-buddy --write && publint"
	},
	"peerDependencies": {
		"@sveltejs/kit": ">=2.0.0",
		"svelte": ">=5.0.0"
	},
	"peerDependenciesMeta": {
		"@sveltejs/kit": {
			"optional": true
		}
	},
	"dependencies": {
		"@iconify-json/ph": "^1.2.2",
		"@iconify-json/simple-icons": "^1.2.100",
		"@iconify/tailwind4": "^1.2.3",
		"@tailwindcss/vite": "^4.3.3",
		"@vnphanquang/markdown": "workspace:*",
		"fontless": "^1.3.2",
		"postcss-color-scheme": "^2.1.0",
		"postcss-custom-media": "^12.0.3",
		"postcss-custom-selectors": "^9.0.4",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@sveltejs/kit": "^3.0.1",
		"schema-dts": "^2.1.0",
		"svelte": "^5.57.2"
	}
}
